# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Database Configuration
# SQLAlchemy database url format for psycopg3 is postgresql+psycopg://user:pass@host:port/db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5454/resume_intelligence

# RAG Ingestion & Splitting Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval & LLM Generation Configuration
TOP_K=5
TEMPERATURE=0.0

GROQ_API_KEY=your_groq_api_key_here
